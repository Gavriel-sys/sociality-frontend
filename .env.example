# Public Sociality API base origin used by client and server fetch abstractions.
# Must be an HTTP or HTTPS root origin without paths (no /api), queries, fragments, or credentials.
# Trailing slash at root is normalized automatically. Localhost with port is supported for development.
# Never place secrets, private keys, or authentication tokens in public variables.
NEXT_PUBLIC_API_BASE_URL=https://be-social-media-api-production.up.railway.app
